{{ 'header-menu-drawer.css' | asset_url | stylesheet_tag }}
<script src="{{ 'header-menu-drawer.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  The phone menu: a drawer over the page, one panel at a time.

  Most panels are the store's own navigation — `section.settings.menu`, the same
  menu the desktop header reads — so a merchant adds a link in Shopify and it is
  here, without it being written down twice.

  Shopify allows three levels, and all three are drawn: a link with children
  opens onto its own panel, and a child with children opens onto one of its own.
  A link without children is a link, and goes where it says.

  The exception is the Shop journey, which lives in `header-menu-drawer-shop`.
  Its levels are not in the store's navigation on purpose — a menu deep enough
  to hold them would put them in the desktop header too — so they are written
  down there, and one row here is pointed at them by name.

  Two kinds of panel are not a list of links:

  - A **picture grid**, for a level whose children are collections worth showing
    by their own image ("Shop by Concern"). The pictures come from the linked
    collections, so there is no second place to keep them up to date.
  - A **pill**, for a link that is a badge rather than a row (NAD+).

  Which is which is named in the section's settings rather than guessed at, so a
  menu can be reordered or renamed without the drawer quietly changing shape.
{%- endcomment -%}

{%- liquid
  assign hmd_menu = section.settings.menu

  comment
    Normalised to ",a,b,c," so a title can be matched whole. Without the commas
    "Shop" would match inside "Shop by Concern", and the wrong panel would come
    out as a grid.
  endcomment
  assign grid_norm = section.settings.hmd_grid_items | default: '' | downcase | replace: ', ', ',' | prepend: ',' | append: ','
  assign pill_norm = section.settings.hmd_pill_items | default: '' | downcase | replace: ', ', ',' | prepend: ',' | append: ','
  assign shop_norm = section.settings.hmd_shop_item | default: '' | downcase | replace: ', ', ',' | prepend: ',' | append: ','

  assign fb = section.settings.hmd_facebook | default: settings.social_facebook_link
  assign ig = section.settings.hmd_instagram | default: settings.social_instagram_link
  assign li = section.settings.hmd_linkedin
-%}

{%- capture hmd_arrow -%}
  <svg class="hmd__arrow" viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true" focusable="false"><path d="M4 10h12M11 5l5 5-5 5" stroke="#33363F" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcapture -%}

<button class="hmd__open" type="button" data-hmd-open aria-label="{{ 'sections.header.menu' | t }}">
  <svg viewBox="0 0 32 32" width="32" height="32" fill="none" aria-hidden="true" focusable="false">
    <path d="M5 10h22M5 16h22M5 22h22" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
</button>

<dialog class="hmd" data-hmd aria-label="{{ 'sections.header.menu' | t }}">
  <div class="hmd__inner">
    <div class="hmd__panels">
      {%- comment -%} ---------------------------------------------- root {%- endcomment -%}
      <section class="hmd__panel" data-hmd-panel="root">
        <div class="hmd__head">
          <div class="hmd__headrow">
            <p class="hmd__title">{{ section.settings.hmd_title | default: 'MENU' }}</p>
            <button class="hmd__close" type="button" data-hmd-close aria-label="{{ 'accessibility.close' | t }}">
              <svg viewBox="0 0 32 32" width="32" height="32" fill="none" aria-hidden="true" focusable="false">
                <path d="M9 9l14 14M23 9L9 23" stroke="#202020" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
          <span class="hmd__rule" aria-hidden="true"></span>
        </div>

        <ul class="hmd__list" role="list">
          {%- for link in hmd_menu.links -%}
            {%- liquid
              assign key = link.title | downcase | prepend: ',' | append: ','
              assign is_pill = false
              if pill_norm contains key
                assign is_pill = true
              endif

              comment
                The one row whose levels are not in the store's navigation. It
                is checked before the menu's own children, so naming a row here
                takes it over whether or not it has any.
              endcomment
              assign is_shop = false
              if shop_norm != ',,' and shop_norm contains key
                assign is_shop = true
                assign shop_title = link.title
              endif
            -%}
            <li class="hmd__item{% if is_pill %} hmd__item--pill{% endif %}">
              {%- if is_pill -%}
                <a class="hmd__pill" href="{{ link.url }}">{{ link.title | escape }}</a>
              {%- elsif is_shop -%}
                <button class="hmd__row" type="button" data-hmd-goto="shop">
                  <span class="hmd__label">{{ link.title | escape }}</span>
                  {{ hmd_arrow }}
                </button>
              {%- elsif link.links.size > 0 -%}
                <button class="hmd__row" type="button" data-hmd-goto="hmd-{{ forloop.index }}">
                  <span class="hmd__label">{{ link.title | escape }}</span>
                  {{ hmd_arrow }}
                </button>
              {%- else -%}
                <a class="hmd__row" href="{{ link.url }}">
                  <span class="hmd__label">{{ link.title | escape }}</span>
                  {{ hmd_arrow }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </section>

      {%- comment -%} --------------------------------- the Shop journey, hardcoded {%- endcomment -%}
      {%- if shop_title != blank -%}
        {%- render 'header-menu-drawer-shop', arrow: hmd_arrow, title: shop_title -%}
      {%- endif -%}

      {%- comment -%} ------------------------------------- level two and three {%- endcomment -%}
      {%- for link in hmd_menu.links -%}
        {%- if link.links.size > 0 -%}
          {%- assign l1 = forloop.index -%}
          {%- liquid
            assign key = link.title | downcase | prepend: ',' | append: ','
            assign l1_grid = false
            if grid_norm contains key
              assign l1_grid = true
            endif
          -%}
          <section class="hmd__panel" data-hmd-panel="hmd-{{ l1 }}" hidden>
            {%- render 'header-menu-drawer-head', title: link.title, back: 'root' -%}
            {%- if l1_grid -%}
              {%- render 'header-menu-drawer-grid', links: link.links -%}
            {%- else -%}
              <ul class="hmd__list" role="list">
                {%- for childlink in link.links -%}
                  <li class="hmd__item">
                    {%- if childlink.links.size > 0 -%}
                      <button class="hmd__row" type="button" data-hmd-goto="hmd-{{ l1 }}-{{ forloop.index }}">
                        <span class="hmd__label">{{ childlink.title | escape }}</span>
                        {{ hmd_arrow }}
                      </button>
                    {%- else -%}
                      <a class="hmd__row" href="{{ childlink.url }}">
                        <span class="hmd__label">{{ childlink.title | escape }}</span>
                        {{ hmd_arrow }}
                      </a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </section>

          {%- for childlink in link.links -%}
            {%- if childlink.links.size > 0 -%}
              {%- assign l2 = forloop.index -%}
              {%- liquid
                assign ckey = childlink.title | downcase | prepend: ',' | append: ','
                assign l2_grid = false
                if grid_norm contains ckey
                  assign l2_grid = true
                endif
              -%}
              {%- capture l2_back -%}hmd-{{ l1 }}{%- endcapture -%}
              <section class="hmd__panel" data-hmd-panel="hmd-{{ l1 }}-{{ l2 }}" hidden>
                {%- render 'header-menu-drawer-head', title: childlink.title, back: l2_back -%}
                {%- if l2_grid -%}
                  {%- render 'header-menu-drawer-grid', links: childlink.links -%}
                {%- else -%}
                  <ul class="hmd__list" role="list">
                    {%- for grandchild in childlink.links -%}
                      <li class="hmd__item">
                        <a class="hmd__row" href="{{ grandchild.url }}">
                          <span class="hmd__label">{{ grandchild.title | escape }}</span>
                          {{ hmd_arrow }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </section>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%}
      One footer for every panel, because it is the same footer on every panel.
      Drawn once outside them so drilling in never redraws it and it never
      scrolls away with the list.
    {%- endcomment -%}
    <footer class="hmd__foot">
      <span class="hmd__rule" aria-hidden="true"></span>
      <div class="hmd__footrow">
        <a class="hmd__account" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
          <svg viewBox="0 0 18 20" width="18" height="20" fill="none" aria-hidden="true" focusable="false">
            <circle cx="9" cy="5.5" r="4.2" stroke="#202020" stroke-width="1.4"/>
            <path d="M1.2 19c0-3.6 3.5-6.2 7.8-6.2s7.8 2.6 7.8 6.2" stroke="#202020" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <span>
            {%- if customer -%}
              {{ 'customer.account_fallback' | t }}
            {%- else -%}
              {{ section.settings.hmd_account_label | default: 'Log in | Sign up' }}
            {%- endif -%}
          </span>
        </a>

        {%- if fb != blank or ig != blank or li != blank -%}
          <ul class="hmd__socials" role="list">
            {%- if fb != blank -%}
              <li><a class="hmd__social" href="{{ fb }}">{{- 'icon-footer-facebook.svg' | inline_asset_content -}}<span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span></a></li>
            {%- endif -%}
            {%- if ig != blank -%}
              <li><a class="hmd__social" href="{{ ig }}">{{- 'icon-footer-instagram.svg' | inline_asset_content -}}<span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span></a></li>
            {%- endif -%}
            {%- if li != blank -%}
              <li><a class="hmd__social hmd__social--li" href="{{ li }}">{{- 'icon-footer-linkedin.svg' | inline_asset_content -}}<span class="visually-hidden">LinkedIn</span></a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </footer>
  </div>
</dialog>
