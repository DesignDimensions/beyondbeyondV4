{% comment %}
  Renders the cart drawer shell.

  The panel's contents live in the `mini-cart` section and are fetched into <mini-cart> the
  first time the drawer opens, rather than rendered into every page -- the cross-sell rail
  costs a run of all_products lookups that most page views never need.

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
{{ 'component-free-shipping.css' | asset_url | stylesheet_tag }}
{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}

{% style %}
  cart-drawer {
    --cart-accent: {{ settings.cart_accent_color | default: '#0107ef' }};
  }
{% endstyle %}

<script src="{{ 'mini-cart-items.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-variant-picker.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-recommendations.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gift-tiers.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gift-wrapping.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'cart-gift-note.js' | asset_url }}" defer="defer"></script>

<cart-drawer{% if cart == empty %} class="is-empty"{% endif %}>
  <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
  <mini-cart
    id="mini-cart"
    class="cart-drawer focus-inset"
    data-url="{{ routes.root }}?section_id=mini-cart"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'sections.cart.title' | t }}"
    tabindex="-1"
  >
    <div class="cart-drawer__loading">
      <div class="loading-overlay__spinner">
        {% render 'icon', icon: 'spinner' %}
      </div>
    </div>
  </mini-cart>
</cart-drawer>
