{% comment %}
  Renders an inline SVG icon by name.

  This theme normally reaches for `{{ 'icon-x.svg' | inline_asset_content }}`. The cart
  drawer was ported from a theme built around a named-icon snippet, and its markup calls
  this on nearly every row -- keeping the snippet means the drawer's Liquid stays a
  line-for-line match with the theme it came from, so the two can still be diffed.

  Only the icons the cart drawer asks for are defined. Anything else falls through to
  nothing rather than erroring.

  Accepts:
  - icon: {String} icon name
  - class: {String} extra classes for the <svg> (optional)

  Usage:
  {% render 'icon', icon: 'close' %}
{% endcomment %}

{%- case icon -%}
  {%- when 'caret' -%}
    <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-caret {{ class }}" fill="none" viewBox="0 0 24 15">
      <path fill-rule="evenodd" clip-rule="evenodd" d="M12 15c-.3 0-.6-.1-.8-.4l-11-13C-.2 1.2-.1.5.3.2c.4-.4 1.1-.3 1.4.1L12 12.5 22.2.4c.4-.4 1-.5 1.4-.1.4.4.5 1 .1 1.4l-11 13c-.1.2-.4.3-.7.3z" fill="currentColor"/>
    </svg>
  {%- when 'checkmark' -%}
    <svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class="icon icon-checkmark {{ class }}" fill="none" viewBox="0 0 20 20">
