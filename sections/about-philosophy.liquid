{{ 'about-philosophy.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The ideas the brand is built on, as a numbered list beside one picture: each
  point is its title and its number on one line, a rule under them, and the
  sentence that explains it below that.

  The numbers are counted off the loop rather than typed into each block, so
  reordering the points in the editor renumbers them instead of leaving 02
  sitting above 01. That also means the markup is a real `<ol>` — the order is
  the content here, not decoration — and the printed numbers are hidden from
  assistive technology, which would otherwise hear each one twice.
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  assign image_src = section.settings.image_url
  if image != blank
    assign image_src = image | image_url: width: 1400
  endif

  assign image_mobile = section.settings.image_mobile
  if image_mobile == blank
    assign image_mobile = image
  endif
-%}

<div
  class="phc{% if section.settings.media_position == 'left' %} phc--reversed{% endif %}"
  style="
    --phc-pad-top: {{ section.settings.padding_top }}px;
    --phc-pad-bottom: {{ section.settings.padding_bottom }}px;
    --phc-bg: {{ section.settings.background }};
    --phc-ink: {{ section.settings.ink }};
    --phc-gap: {{ section.settings.column_gap }}px;
    --phc-align: {{ section.settings.vertical_alignment }};
    --phc-media-w: {{ section.settings.media_width }}%;
    --phc-media-ratio: {{ section.settings.media_ratio }};
    {%- if section.settings.media_ratio_mobile != blank %}
      --phc-media-ratio-mobile: {{ section.settings.media_ratio_mobile }};
    {%- endif %}
    --phc-media-bg: {{ section.settings.media_background }};
    --phc-media-radius: {{ section.settings.media_radius }}px;
    --phc-head-gap: {{ section.settings.head_gap }}px;
    --phc-item-gap: {{ section.settings.item_gap }}px;
    --phc-rule-gap: {{ section.settings.rule_gap }}px;
    --phc-rule-color: {{ section.settings.rule_color }};
    --phc-title-size: {{ section.settings.title_size }}px;
    --phc-number-size: {{ section.settings.number_size }}px;
    --phc-number-color: {{ section.settings.number_color }};
    --phc-text-size: {{ section.settings.text_size }}px;
    --phc-text-color: {{ section.settings.text_color }};
  "
  {{ section.shopify_attributes }}
>
  <div class="page-width phc__row">
    <div class="phc__copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="phc__intro section-text">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="phc__list">
          {%- for block in section.blocks -%}
            <li class="phc__item" {{ block.shopify_attributes }}>
              <div class="phc__item-head">
                {%- if block.settings.title != blank -%}
                  {%- if block.settings.link != blank -%}
                    <h3 class="phc__title">
                      <a class="phc__title-link" href="{{ block.settings.link }}">{{ block.settings.title }}</a>
                    </h3>
                  {%- else -%}
                    <h3 class="phc__title">{{ block.settings.title }}</h3>
                  {%- endif -%}
                {%- endif -%}

                {%- if section.settings.show_numbers -%}
                  {%- liquid
                    assign n = forloop.index
                    if n < 10
                      assign counter = n | prepend: '0'
                    else
                      assign counter = n
                    endif
                  -%}
                  <span class="phc__number" aria-hidden="true">{{ counter }}</span>
                {%- endif -%}
              </div>

              <hr class="phc__rule">

              {%- if block.settings.text != blank -%}
                <div class="phc__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>

    <div class="phc__media">
      {%- if image_src != blank -%}
        <picture>
          {%- if section.settings.image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ image_mobile | image_url: width: 600 }} 600w,
                {{ image_mobile | image_url: width: 900 }} 900w,
                {{ image_mobile | image_url: width: 1200 }} 1200w
              "
              sizes="92vw"
            >
          {%- endif -%}
          <img
            class="phc__img"
            src="{{ image_src }}"
            {%- if image != blank %}
              srcset="
                {{ image | image_url: width: 600 }} 600w,
                {{ image | image_url: width: 900 }} 900w,
                {{ image | image_url: width: 1400 }} 1400w
              "
              width="{{ image.width }}"
              height="{{ image.height }}"
            {%- endif %}
            sizes="(min-width: 750px) {{ section.settings.media_width }}vw, 92vw"
            alt="{{ section.settings.image_alt | escape }}"
            loading="lazy"
            decoding="async"
          >
        </picture>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Philosophy",
  "tag": "section",
  "class": "section-about-philosophy",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Set in the theme's shared section statement.",
      "default": "Our Philosophy"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Intro",
      "info": "Optional — sits between the heading and the list."
    },
    {
      "type": "range",
      "id": "head_gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Space below heading",
      "default": 48
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Heading colour",
      "default": "#0A0A0B"
    },
    {
      "type": "header",
      "content": "List"
    },
    {
      "type": "checkbox",
      "id": "show_numbers",
      "label": "Number the points",
      "info": "Counted automatically, so reordering the points renumbers them.",
      "default": true
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 28,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "range",
      "id": "number_size",
      "min": 9,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Number size",
      "default": 13
    },
    {
      "type": "color",
      "id": "number_color",
      "label": "Number colour",
      "default": "#0A0A0B"
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 9,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Description size",
      "default": 13
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Description colour",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "rule_color",
      "label": "Rule colour",
      "default": "#1A1A1A"
    },
    {
      "type": "range",
      "id": "rule_gap",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Space around the rule",
      "default": 12
    },
    {
      "type": "range",
      "id": "item_gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Space between points",
      "default": 40
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile)",
      "info": "Optional — a separate crop for small screens. Falls back to the desktop image above."
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Image URL",
      "info": "Used when no image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image description",
      "info": "Read out in place of the image."
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape (desktop)",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "0.9", "label": "Slight portrait" },
        { "value": "0.815", "label": "Portrait" },
        { "value": "1.15", "label": "Wide" },
        { "value": "auto", "label": "Original" }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "media_ratio_mobile",
      "label": "Image shape (mobile)",
      "options": [
        { "value": "", "label": "Same as desktop" },
        { "value": "1", "label": "Square" },
        { "value": "0.815", "label": "Portrait" },
        { "value": "1.15", "label": "Wide" },
        { "value": "auto", "label": "Original" }
      ],
      "default": ""
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Image background",
      "info": "Shows while the image loads, and in place of it before one is chosen.",
      "default": "#DEDEDE"
    },
    {
      "type": "range",
      "id": "media_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Image corner radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "media_width",
      "min": 30,
      "max": 65,
      "step": 1,
      "unit": "%",
      "label": "Image width",
      "info": "As a share of the content column. The list takes what is left.",
      "default": 48
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Space between list and image",
      "default": 40
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Image alignment",
      "options": [
        { "value": "flex-start", "label": "Top" },
        { "value": "center", "label": "Middle" },
        { "value": "stretch", "label": "Fill the column" }
      ],
      "default": "flex-start"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Intentional Formulation"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Description",
          "default": "<p>We use only proven, effective ingredients at functional levels. No fillers. No guesswork.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional — turns the title into a link."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Philosophy",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
