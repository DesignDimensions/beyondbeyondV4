{{ 'about-statement.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  A statement band: the theme's shared overline over its shared statement on
  the left, and the paragraph that answers them — with an optional button — on
  the right.

  The about page uses this shape twice, once on white with a button ("Our
  Mindset") and once on a tinted band without one ("Our Approach"). They are
  the same section rather than two, because the only things that differ are a
  colour and whether the button is filled in — and a merchant editing one of
  them should not have to learn a second set of controls to edit the other.

  Nothing here sets a type size. The overline is `.section-heading` and the
  statement is `.section-title`, the two `base.css` publishes for every
  section on the site, held to the size a half column can carry exactly the
  way the blog carousel holds them. Only the tint is claimed back, the way the
  consultation panel claims it — each band on this page is a different colour,
  but none of them is a different typeface.

  The band itself runs the full width of the viewport while its contents keep
  to the theme's content column, so a tint reaches both edges of the screen
  without the copy ever leaving the grid the rest of the page sits on.
{%- endcomment -%}

{%- liquid
  comment
    The heading is a textarea rather than a single-line field: the design
    breaks "Zero Harsh Additives. / 100% Thoughtful Skincare." over two lines
    at a point no automatic wrap would choose. Escaped first, so the line
    breaks are the only markup that survives.
  endcomment
  assign heading = section.settings.heading | escape | newline_to_br
-%}

<div
  class="abs{% if section.settings.offset_header %} abs--under-header{% endif %}"
  style="
    --abs-pad-top: {{ section.settings.padding_top }}px;
    --abs-pad-bottom: {{ section.settings.padding_bottom }}px;
    --abs-bg: {{ section.settings.background }};
    --abs-ink: {{ section.settings.ink }};
    --abs-gap: {{ section.settings.column_gap }}px;
    --abs-lead-w: {{ section.settings.lead_width }}%;
    --abs-copy-offset: {{ section.settings.copy_offset }}px;
    --abs-body-color: {{ section.settings.body_color }};
    --abs-body-gap: {{ section.settings.body_gap }}px;
    --abs-cta-gap: {{ section.settings.cta_gap }}px;
    --abs-cta-max: {{ section.settings.cta_width }}px;
    --abs-cta-h: {{ section.settings.cta_height }}px;
    --abs-cta-radius: {{ section.settings.cta_radius }}px;
    --abs-cta-bg: {{ section.settings.cta_background }};
    --abs-cta-fg: {{ section.settings.cta_color }};
  "
  {{ section.shopify_attributes }}
>
  <div class="page-width abs__row">
    <div class="abs__lead">
      {%- comment -%}
        Kept adjacent siblings on purpose: `base.css` closes the gap between
        an overline and the statement under it with `:has(+ .section-title)`,
        and anything between the two would break that pairing and leave the
        label floating at arm's length.
      {%- endcomment -%}
      {%- if section.settings.eyebrow != blank -%}
        <p class="section-heading">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="section-title">{{ heading }}</h2>
      {%- endif -%}
    </div>

    <div class="abs__copy">
      {%- if section.settings.body != blank -%}
        <div class="abs__body section-text">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="abs__cta" href="{{ section.settings.cta_link | default: '#' }}">
          <span class="abs__cta-label">{{ section.settings.cta_label }}</span>
          {%- comment -%}
            The blog carousel's arrow, so every CTA in the theme reads as the
            same gesture. Masked rather than an inline path — see that file.
          {%- endcomment -%}
          <span class="abs__cta-arrow" aria-hidden="true"></span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "About Statement",
  "tag": "section",
  "class": "section-about-statement",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "offset_header",
      "label": "Start below the header",
      "info": "Turn on when this is the first section on the page. The site header floats over the page until it is scrolled, so the first section has to hold its own content clear of it.",
      "default": false
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "info": "Runs the full width of the screen. The copy keeps to the content column.",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Heading colour",
      "info": "Tints the label and the heading together.",
      "default": "#0A0A0B"
    },
    {
      "type": "range",
      "id": "lead_width",
      "min": 35,
      "max": 70,
      "step": 1,
      "unit": "%",
      "label": "Heading column width",
      "info": "As a share of the content column. The text beside it takes what is left.",
      "default": 52
    },
    {
      "type": "range",
      "id": "column_gap",
      "min": 16,
      "max": 140,
      "step": 4,
      "unit": "px",
      "label": "Space between columns",
      "default": 80
    },
    {
      "type": "range",
      "id": "copy_offset",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Drop the text column",
      "info": "Nudges the right column down so it starts level with the heading rather than with the label above it.",
      "default": 38
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label",
      "info": "Set in the theme's shared section label.",
      "default": "OUR MINDSET"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Set in the theme's shared section statement. Press Enter to break it onto a new line.",
      "default": "A Brand that doesn't just sit on your shelf, it fits into your life."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>In a world bursting with choices, we believe skincare should stand out not by shouting louder, but by meaning more. Beyond Beyond is about bringing together science, care, and intention to create something truly significant.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Text colour",
      "default": "#1A1A1A"
    },
    {
      "type": "range",
      "id": "body_gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Space above the text",
      "default": 16
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "info": "Leave empty to hide the button.",
      "default": "Shop The Product"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "cta_gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Space above button",
      "default": 30
    },
    {
      "type": "range",
      "id": "cta_width",
      "min": 160,
      "max": 640,
      "step": 10,
      "unit": "px",
      "label": "Button width",
      "info": "The button fills its column up to this width.",
      "default": 380
    },
    {
      "type": "range",
      "id": "cta_height",
      "min": 32,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Button height",
      "default": 48
    },
    {
      "type": "range",
      "id": "cta_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "label": "Button corner radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "cta_color",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "About Statement"
    }
  ]
}
{% endschema %}
