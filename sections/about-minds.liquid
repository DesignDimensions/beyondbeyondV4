{{ 'about-minds.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  The people behind the brand, as a rail of portraits with a name and a role
  laid over the foot of each.

  The rail is a native scroll box: a swipe on a phone and a trackpad on a
  desktop already move it, and the arrows in the gutters only have to step it
  on by a card and say when there is nothing left in that direction. That is
  also why the section still works with JavaScript off — it degrades to a row
  the reader can scroll, not to a row they cannot reach the end of.
{%- endcomment -%}

{%- liquid
  comment
    The mark is the brand's own, drawn rather than typed: the quotation glyph
    a font supplies is a different shape in every face, and this one is the
    shape the brand uses. Picked in the editor for the usual case, by URL for
    artwork that lives elsewhere — resolved to one src here so the markup below
    only has to ask about it once.
  endcomment
  assign quote_image = section.settings.quote_image
  assign quote_src = section.settings.quote_image_url
  if quote_image != blank
    assign quote_src = quote_image | image_url: width: 600
  endif
-%}

<div
  class="mnd"
  style="
    --mnd-pad-top: {{ section.settings.padding_top }}px;
    --mnd-pad-bottom: {{ section.settings.padding_bottom }}px;
    --mnd-bg: {{ section.settings.background }};
    --mnd-head-gap: {{ section.settings.head_gap }}px;
    --mnd-ink: {{ section.settings.ink }};
    --mnd-body-color: {{ section.settings.body_color }};
    --mnd-body-w: {{ section.settings.body_width }}px;
    --mnd-quote-w: {{ section.settings.quote_width }}px;
    --mnd-columns: {{ section.settings.columns_desktop }};
    --mnd-columns-mobile: {{ section.settings.columns_mobile }};
    --mnd-card-gap: {{ section.settings.card_gap }}px;
    --mnd-card-radius: {{ section.settings.card_radius }}px;
    --mnd-card-bg: {{ section.settings.card_background }};
    --mnd-card-inset: {{ section.settings.card_inset }}px;
    --mnd-caption-bg: {{ section.settings.caption_background }};
    --mnd-caption-opacity: {{ section.settings.caption_opacity | divided_by: 100.0 }};
    --mnd-card-text: {{ section.settings.card_text_color }};
  "
  {{ section.shopify_attributes }}
>
  <div class="page-width mnd__head">
    <div class="mnd__head-copy">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="mnd__body section-text">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>

    {%- comment -%}
      Decoration rather than a quotation — there is nothing being quoted — so
      it carries an empty alt and is kept away from assistive technology
      entirely.

      A picked image brings its own width and height, which reserve its space
      before it loads. The URL path cannot know them, so it takes a class that
      hands it the default mark's proportions instead — applied only there, so
      a differently shaped image chosen in the editor is never letterboxed
      into the wrong ratio.
    {%- endcomment -%}
    {%- if section.settings.show_quote_mark and quote_src != blank -%}
      <img
        class="mnd__quote{% if quote_image == blank %} mnd__quote--url{% endif %}"
        src="{{ quote_src }}"
        {%- if quote_image != blank %}
          width="{{ quote_image.width }}"
          height="{{ quote_image.height }}"
        {%- endif %}
        alt=""
        aria-hidden="true"
        loading="lazy"
        decoding="async"
      >
    {%- endif -%}
  </div>

  {%- comment -%}
    No arrows: the row holds three people and three cards fit the column
    exactly, so on a desktop there is nothing to step through. Narrower than
    that the rail is still a scroll box, which a thumb already swipes — so
    what was a carousel is now just a row that happens to scroll when it has
    to, and needs no script at all.
  {%- endcomment -%}
  <div class="page-width mnd__frame">
    <div
      class="mnd__rail"
      id="mnd-rail-{{ section.id }}"
      tabindex="0"
      role="group"
      aria-label="{{ section.settings.heading | default: 'The people behind the brand' | escape }}"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign image = block.settings.image
          assign image_src = block.settings.image_url
          if image != blank
            assign image_src = image | image_url: width: 900
          endif
          assign role = block.settings.role | escape | newline_to_br
        -%}

        <article class="mnd__card" {{ block.shopify_attributes }}>
          {%- comment -%}
            The whole card is the link when one is set, laid over the portrait
            rather than wrapped around it — a link around a figure with text
            inside it reads back as one long run of words, where this keeps the
            name as the accessible name of the link and the rest as content.
          {%- endcomment -%}
          {%- if block.settings.link != blank -%}
            <a class="mnd__card-link" href="{{ block.settings.link }}">
              <span class="visually-hidden">{{ block.settings.name }}</span>
            </a>
          {%- endif -%}

          {%- comment -%}
            The portrait is shown at its own full height rather than cropped
            to a fixed card shape, so there is nothing to give an empty card
            its height before a picture is chosen — the empty state carries
            the drawn proportion itself.
          {%- endcomment -%}
          <div class="mnd__media{% if image_src == blank %} mnd__media--empty{% endif %}">
            {%- if image_src != blank -%}
              <img
                class="mnd__img"
                src="{{ image_src }}"
                {%- if image != blank %}
                  srcset="
                    {{ image | image_url: width: 400 }} 400w,
                    {{ image | image_url: width: 700 }} 700w,
                    {{ image | image_url: width: 1000 }} 1000w
                  "
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                {%- endif %}
                sizes="(min-width: 750px) calc(100vw / {{ section.settings.columns_desktop }}), 70vw"
                alt="{{ block.settings.name | escape }}"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
          </div>

          <div class="mnd__caption">
            {%- if block.settings.name != blank -%}
              <h3 class="mnd__name">{{ block.settings.name }}</h3>
            {%- endif -%}
            {%- if role != blank -%}
              <p class="mnd__role">{{ role }}</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Minds Behind",
  "tag": "section",
  "class": "section-about-minds",
  "settings": [
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Set in the theme's shared section statement.",
      "default": "Minds Behind Beyond Beyond"
    },
    {
      "type": "color",
      "id": "ink",
      "label": "Heading colour",
      "default": "#0A0A0B"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>A collective of industry pioneers shaping the future of clean clinical skincare, powered by NAD+.</p>"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Text colour",
      "default": "#3D3D3D"
    },
    {
      "type": "range",
      "id": "body_width",
      "min": 240,
      "max": 720,
      "step": 10,
      "unit": "px",
      "label": "Text width",
      "default": 420
    },
    {
      "type": "range",
      "id": "head_gap",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Space below header",
      "default": 36
    },
    {
      "type": "checkbox",
      "id": "show_quote_mark",
      "label": "Show quote mark",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "quote_image",
      "label": "Quote mark"
    },
    {
      "type": "text",
      "id": "quote_image_url",
      "label": "Quote mark URL",
      "info": "Used when no quote mark is picked above. Defaults to the brand's own mark.",
      "default": "https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Group_890.png?v=1787640838"
    },
    {
      "type": "range",
      "id": "quote_width",
      "min": 20,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Quote mark width",
      "info": "The height follows the artwork's own proportions.",
      "default": 48
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Cards per row (desktop)",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "1.2",
          "label": "1 and a peek"
        },
        {
          "value": "1.5",
          "label": "1 and a half"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1.2"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space between cards",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_radius",
      "min": 0,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 0
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "info": "Shows while a portrait loads, and in place of one before it is chosen.",
      "default": "#C9CCD6"
    },
    {
      "type": "range",
      "id": "card_inset",
      "min": 8,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Caption inset",
      "default": 28
    },
    {
      "type": "color",
      "id": "caption_background",
      "label": "Caption background",
      "default": "#5C5C5C"
    },
    {
      "type": "range",
      "id": "caption_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Caption strength",
      "default": 90
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Caption colour",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#E8EDF7"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "person",
      "name": "Person",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Portrait"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Portrait URL",
          "info": "Used when no portrait is picked above."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Aparna Kakrania"
        },
        {
          "type": "textarea",
          "id": "role",
          "label": "Role",
          "info": "Press Enter to break the role onto a new line.",
          "default": "Brand Builder, Designer\nStoryteller"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional — makes the whole card clickable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Minds Behind",
      "blocks": [
        {
          "type": "person"
        },
        {
          "type": "person"
        },
        {
          "type": "person"
        }
      ]
    }
  ]
}
{% endschema %}
