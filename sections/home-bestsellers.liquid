{{ 'home-bestsellers.css' | asset_url | stylesheet_tag }}
<div class="home-bestsellers-container">
  <div class="page-width">
    <p class="section-heading">{{ section.settings.heading }}</p>
    <div class="home-bestsellers-products">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        <div class="home-bestsellers-product">
          <img
            src="{{ product.featured_image | image_url }}"
            class="home-bestsellers-product-image"
          />
          <div class="home-bestsellers-product-details">
            <img
              src="{{ block.settings.ingredient_left | image_url }}"
              class="home-bestsellers-product-ingredient-left"
            />
            <img
              src="{{ block.settings.middle_logo | image_url }}"
              class="home-bestsellers-product-middle-logo"
            />
            <img
              src="{{ block.settings.ingredient_right | image_url }}"
              class="home-bestsellers-product-ingredient-right"
            />
            <p>{{ block.settings.product_caption }}</p>
            <p>{{ block.settings.product_title }}</p>
            <p>
              {{ block.settings.pre_price }}
              <span>{{ product.price | money }}</span>
            </p>
            <img
              src="{{ block.settings.ingredient_bottom | image_url }}"
              class="home-bestsellers-product-ingredient-bottom"
            />
            <a href="{{ product.url }}" class="home-bestsellers-product-link">{{ block.settings.cta }}</a>
          </div>
          <img
            src="{{ product.metafields.custom.bestseller_image | image_url }}"
            class="home-bestsellers-product-image"
          />
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Home Bestsellers",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "home_bestsellers_product",
      "name": "Home Bestsellers Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "ingredient_left",
          "label": "Ingredient Left"
        },
        {
          "type": "image_picker",
          "id": "middle_logo",
          "label": "Middle Logo"
        },
        {
          "type": "image_picker",
          "id": "ingredient_right",
          "label": "Ingredient Right"
        },
        {
          "type": "text",
          "id": "product_caption",
          "label": "Product Caption"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Product Title"
        },
        {
          "type": "text",
          "id": "pre_price",
          "label": "Pre Price Text"
        },
        {
          "type": "image_picker",
          "id": "ingredient_bottom",
          "label": "Ingredient Bottom"
        },
        {
          "type": "text",
          "id": "cta",
          "label": "CTA Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Bestsellers"
    }
  ]
}
{% endschema %}
