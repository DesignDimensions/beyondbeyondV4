{{ 'footer-main.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign has_social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign has_social_icons = false
  endif
-%}

<div
  class="ftm color-{{ section.settings.color_scheme }} gradient"
  id="ftm-{{ section.id }}"
  style="
    --ftm-pad-top: {{ section.settings.padding_top }}px;
    --ftm-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ftm-logo-width: {{ section.settings.logo_width }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="page-width ftm__grid">
    <div class="ftm__brand">
      {%- if section.settings.logo != blank -%}
        <a href="{{ routes.root_url }}" class="ftm__logo-link">
          <img
            class="ftm__logo-img"
            src="{{ section.settings.logo | image_url: width: 400 }}"
            srcset="
              {{ section.settings.logo | image_url: width: 200 }}  200w,
              {{ section.settings.logo | image_url: width: 400 }}  400w,
              {{ section.settings.logo | image_url: width: 600 }}  600w
            "
            width="{{ section.settings.logo.width }}"
            height="{{ section.settings.logo.height }}"
            alt="{{ shop.name | escape }}"
            loading="lazy"
            decoding="async"
          >
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="ftm__logo-link ftm__logo-text">{{ shop.name }}</a>
      {%- endif -%}

      {%- if section.settings.newsletter_enable -%}
        <div class="ftm__newsletter">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="ftm__newsletter-heading">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}
          {%- assign newsletter_form_id = 'FooterMainNewsletter-' | append: section.id -%}
          {%- form 'customer', id: newsletter_form_id, class: 'ftm__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="ftm__newsletter-field">
              <input
                id="FooterMainNewsletterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="ftm__newsletter-input"
                value="{{ form.email }}"
                aria-label="{{ 'newsletter.label' | t }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="Enter your email"
                required
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="FooterMainNewsletterError-{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="FooterMainNewsletterSuccess-{{ section.id }}"
                {% endif %}
              >
              <button
                type="submit"
                class="ftm__newsletter-submit"
                name="commit"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                <span class="ftm__newsletter-arrow">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
              </button>
            </div>
            {%- if form.errors -%}
              <small class="ftm__newsletter-message" id="FooterMainNewsletterError-{{ section.id }}">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </small>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p
                class="ftm__newsletter-message"
                id="FooterMainNewsletterSuccess-{{ section.id }}"
                tabindex="-1"
              >
                {{- 'newsletter.success' | t -}}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_social and has_social_icons -%}
        <div class="ftm__follow">
          {%- if section.settings.social_label != blank -%}
            <p class="ftm__follow-label">{{ section.settings.social_label }}</p>
          {%- endif -%}
          {%- render 'social-icons', class: 'ftm__social' -%}
        </div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="ftm__menus">
        {%- comment -%}
          Three independent passes over the same block list, one per column,
          so each column's height comes only from its own headings and links
          — a flex column here rather than a grid cell, since a shared grid
          row would let a tall column drag a short one's second group down.
        {%- endcomment -%}
        {%- for col in (1..3) -%}
          {%- liquid
            assign col_string = col | append: ''
            assign current_heading_column = ''
            assign menu_open = false
            assign has_column_content = false
          -%}
          {%- capture column_html -%}
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'menu_heading' -%}
                  {%- assign current_heading_column = block.settings.column -%}
                  {%- if current_heading_column == col_string -%}
                    {%- assign has_column_content = true -%}
                    {%- if menu_open -%}
                      </ul>
                      </div>
                    {%- endif -%}
                    <div class="ftm__menu" {{ block.shopify_attributes }}>
                      {%- if block.settings.heading != blank -%}
                        <h2 class="ftm__menu-heading">{{ block.settings.heading }}</h2>
                      {%- endif -%}
                      <ul class="ftm__menu-list list-unstyled">
                        {%- assign menu_open = true -%}
                  {%- else -%}
                    {%- if menu_open -%}
                      </ul>
                      </div>
                    {%- endif -%}
                    {%- assign menu_open = false -%}
                  {%- endif -%}
                {%- when 'menu_link' -%}
                  {%- if menu_open and current_heading_column == col_string and block.settings.title != blank -%}
                    <li>
                      <a href="{{ block.settings.url }}" class="ftm__menu-link" {{ block.shopify_attributes }}>
                        {{- block.settings.title | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
              {%- endcase -%}
            {%- endfor -%}
            {%- if menu_open -%}
              </ul>
              </div>
            {%- endif -%}
          {%- endcapture -%}
          {%- if has_column_content -%}
            <div class="ftm__menu-column">{{ column_html }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Footer Main",
  "tag": "section",
  "class": "section-footer-main",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 220
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter form",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join our community and get 10% off on your first purchase"
    },
    {
      "type": "header",
      "content": "Follow us"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "info": "Uses the links set in Theme settings > Social media.",
      "default": true
    },
    {
      "type": "text",
      "id": "social_label",
      "label": "Label",
      "default": "Follow us"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "menu_heading",
      "name": "Menu heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Menu"
        },
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "info": "Headings sharing a column stack in the order they're listed here. The links below a heading belong to it, until the next heading.",
          "options": [
            { "value": "1", "label": "1" },
            { "value": "2", "label": "2" },
            { "value": "3", "label": "3" }
          ],
          "default": "1"
        }
      ]
    },
    {
      "type": "menu_link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Main",
      "blocks": [
        { "type": "menu_heading", "settings": { "heading": "Shop", "column": "1" } },
        { "type": "menu_link", "settings": { "title": "The Ultimate Night Repair Super Cream", "url": "/products/the-ultimate-night-repair-supercream" } },
        { "type": "menu_link", "settings": { "title": "Hydro-Active Day Cream", "url": "/products/hydro-active-day-cream" } },
        { "type": "menu_link", "settings": { "title": "Moisture Surge Lip Butter", "url": "/products/moisture-surge-lip-butter" } },
        { "type": "menu_link", "settings": { "title": "Oil-Free Matte Sunscreen", "url": "/products/oil-free-matte-sunscreen" } },
        { "type": "menu_link", "settings": { "title": "Dirt & Makeup Cleanser Jelly", "url": "/products/dirt-makeup-cleanser-jelly" } },
        { "type": "menu_link", "settings": { "title": "Deep Clean Enzyme Cleanser", "url": "/products/deep-clean-enzyme-cleanser" } },
        { "type": "menu_link", "settings": { "title": "Broad Spectrum Active Sunspray", "url": "/products/broad-spectrum-active-sunspray" } },
        { "type": "menu_link", "settings": { "title": "Ultra Hydrating Oligo HA Mist", "url": "/products/ultra-hydrating-oligo-ha-mist" } },
        { "type": "menu_link", "settings": { "title": "Advanced Complexion Corrector Serum", "url": "/products/advanced-complexion-corrector-serum" } },
        { "type": "menu_link", "settings": { "title": "Advanced Cellular Repair Serum", "url": "/products/advanced-cellular-repair-serum" } },
        { "type": "menu_link", "settings": { "title": "Advanced Cellular Hydration Serum", "url": "/products/advanced-cellular-hydration-serum" } },
        { "type": "menu_link", "settings": { "title": "Advanced Antioxidant Defense Serum", "url": "/products/advanced-antioxidant-defense-serum" } },

        { "type": "menu_heading", "settings": { "heading": "Beyond Beyond", "column": "2" } },
        { "type": "menu_link", "settings": { "title": "Beyond Beyond", "url": "/pages/beyond-beyond" } },
        { "type": "menu_link", "settings": { "title": "Bestsellers", "url": "/collections/bestsellers-1" } },
        { "type": "menu_link", "settings": { "title": "About", "url": "/pages/clean-clinical-skincare" } },

        { "type": "menu_heading", "settings": { "heading": "Customer care", "column": "2" } },
        { "type": "menu_link", "settings": { "title": "Contact Us", "url": "/pages/contact" } },
        { "type": "menu_link", "settings": { "title": "Track Orders", "url": "/" } },
        { "type": "menu_link", "settings": { "title": "FAQ", "url": "/pages/faqs" } },

        { "type": "menu_heading", "settings": { "heading": "Learn", "column": "3" } },
        { "type": "menu_link", "settings": { "title": "Journal", "url": "/blogs/news" } },
