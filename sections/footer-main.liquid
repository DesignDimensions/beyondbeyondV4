{{ 'footer-main.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign facebook_url = section.settings.facebook_url | default: settings.social_facebook_link
  assign instagram_url = section.settings.instagram_url | default: settings.social_instagram_link
  assign linkedin_url = section.settings.linkedin_url

  assign has_social = false
  if facebook_url != blank or instagram_url != blank or linkedin_url != blank
    assign has_social = true
  endif
-%}

{%- comment -%}
  The wordmark is drawn twice and only ever shown once: desktop puts it at the
  head of the brand column, the phone layout puts it on the row with the social
  icons instead. Captured here so the markup for it is written the once.
{%- endcomment -%}
{%- capture footer_logo_inner -%}
  {%- if section.settings.logo != blank -%}
    <img
      class="ftm__logo-img"
      src="{{ section.settings.logo | image_url: width: 400 }}"
      srcset="
        {{ section.settings.logo | image_url: width: 200 }} 200w,
        {{ section.settings.logo | image_url: width: 400 }} 400w,
        {{ section.settings.logo | image_url: width: 600 }} 600w
      "
      width="{{ section.settings.logo.width }}"
      height="{{ section.settings.logo.height }}"
      alt="{{ shop.name | escape }}"
      loading="lazy"
      decoding="async"
    >
  {%- else -%}
    {{- 'footer-logo.svg' | inline_asset_content -}}
  {%- endif -%}
  <span class="visually-hidden">{{ shop.name }}</span>
{%- endcapture -%}

<div
  class="ftm"
  id="ftm-{{ section.id }}"
  style="
    --ftm-pad-top: {{ section.settings.padding_top }}px;
    --ftm-pad-bottom: {{ section.settings.padding_bottom }}px;
    --ftm-logo-width: {{ section.settings.logo_width }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="page-width ftm__grid">
    <div class="ftm__brand">
      <a href="{{ routes.root_url }}" class="ftm__logo ftm__logo--top">{{ footer_logo_inner }}</a>

      <div class="ftm__stack">
        {%- if section.settings.newsletter_enable -%}
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="ftm__heading">{{ section.settings.newsletter_heading }}</h2>
          {%- endif -%}

          {%- assign newsletter_form_id = 'FooterMainNewsletter-' | append: section.id -%}
          {%- form 'customer', id: newsletter_form_id, class: 'ftm__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">

            {%- comment -%}
              Once it has gone through, the confirmation takes the field's
              place rather than sitting under it — there is nothing left to
              type. It holds focus so a screen reader is told what happened
              without having to hunt for the message.
            {%- endcomment -%}
            {%- if form.posted_successfully? -%}
              <div class="ftm__success" id="FooterMainNewsletterSuccess-{{ section.id }}" tabindex="-1">
                {%- if section.settings.newsletter_success_heading != blank -%}
                  <p class="ftm__success-heading">{{ section.settings.newsletter_success_heading }}</p>
                {%- endif -%}
                {%- if section.settings.newsletter_success_text != blank -%}
                  <p class="ftm__success-text">{{ section.settings.newsletter_success_text }}</p>
                {%- endif -%}
              </div>
            {%- else -%}
            <div class="ftm__field">
              <input
                id="FooterMainNewsletterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="ftm__input"
                value="{{ form.email }}"
                aria-label="{{ 'newsletter.label' | t }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ section.settings.newsletter_placeholder | escape }}"
                required
                {% if form.errors %}
                  autofocus
                  aria-invalid="true"
                  aria-describedby="FooterMainNewsletterError-{{ section.id }}"
                {% elsif form.posted_successfully? %}
                  aria-describedby="FooterMainNewsletterSuccess-{{ section.id }}"
                {% endif %}
              >
              <button
                type="submit"
                class="ftm__submit"
                name="commit"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                {{- 'icon-footer-arrow-right.svg' | inline_asset_content -}}
              </button>
            </div>
            {%- if form.errors -%}
              <small class="ftm__form-message" id="FooterMainNewsletterError-{{ section.id }}">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </small>
            {%- endif -%}
            {%- endif -%}
          {%- endform -%}
        {%- endif -%}

        {%- comment -%}
          The phone layout sets the wordmark and the social icons on one row,
          the mark to the left and the icons to the right. On a wide screen the
          mark in here is hidden and the row carries the icons alone, exactly
          as it did before.
        {%- endcomment -%}
        <div class="ftm__foot">
          <a href="{{ routes.root_url }}" class="ftm__logo ftm__logo--foot" aria-hidden="true" tabindex="-1">
            {{- footer_logo_inner -}}
          </a>

        {%- if section.settings.show_social and has_social -%}
          <ul class="ftm__social list-unstyled" role="list">
            {%- if facebook_url != blank -%}
              <li>
                <a href="{{ facebook_url }}" class="ftm__social-link ftm__social-link--fb">
                  {{- 'icon-footer-facebook.svg' | inline_asset_content -}}
                  <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if instagram_url != blank -%}
              <li>
                <a href="{{ instagram_url }}" class="ftm__social-link ftm__social-link--ig">
                  {{- 'icon-footer-instagram.svg' | inline_asset_content -}}
                  <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                </a>
              </li>
            {%- endif -%}
            {%- if linkedin_url != blank -%}
              <li>
                <a href="{{ linkedin_url }}" class="ftm__social-link ftm__social-link--li">
                  {{- 'icon-footer-linkedin.svg' | inline_asset_content -}}
                  <span class="visually-hidden">LinkedIn</span>
                </a>
              </li>
            {%- endif -%}
          </ul>
        {%- endif -%}
        </div>
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <nav class="ftm__menus">
        {%- comment -%}
          Each menu_heading is a column, and the links between it and the next
          heading are its own — so the inner loop starts just past the heading
          and stops at whichever heading comes next.
        {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu_heading' -%}
            {%- assign links_from = forloop.index -%}
            <div class="ftm__menu" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="ftm__menu-heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              <ul class="ftm__menu-list list-unstyled" role="list">
                {%- for link in section.blocks offset: links_from -%}
                  {%- if link.type == 'menu_heading' -%}
                    {%- break -%}
                  {%- endif -%}
                  {%- if link.settings.title != blank -%}
                    <li>
                      <a href="{{ link.settings.url }}" class="ftm__menu-link" {{ link.shopify_attributes }}>
                        {{- link.settings.title | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Footer Main",
  "tag": "section",
  "class": "section-footer-main",
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Leave empty to use the built-in Beyond Beyond wordmark."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 200,
      "step": 1,
      "unit": "px",
      "label": "Logo width",
      "default": 137
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter form",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join our community and get 10% off on your first purchase"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_success_heading",
      "label": "Success heading",
      "info": "Replaces the email field once someone has signed up.",
      "default": "You're in!"
    },
    {
      "type": "text",
      "id": "newsletter_success_text",
      "label": "Success text",
      "default": "Please check your email for confirmation"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social icons",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook",
      "info": "Falls back to Theme settings > Social media."
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram",
      "info": "Falls back to Theme settings > Social media."
    },
    {
      "type": "url",
      "id": "linkedin_url",
      "label": "LinkedIn"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "menu_heading",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Menu",
          "info": "Starts a new column. Every link below it belongs to this column, until the next column heading."
        }
      ]
    },
    {
      "type": "menu_link",
      "name": "Link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer Main",
      "blocks": [
        { "type": "menu_heading", "settings": { "heading": "Beyond Beyond" } },
        { "type": "menu_link", "settings": { "title": "Home", "url": "/" } },
        { "type": "menu_link", "settings": { "title": "Shop", "url": "/collections/all" } },
        { "type": "menu_link", "settings": { "title": "Bestsellers", "url": "/collections/bestsellers-1" } },
        { "type": "menu_link", "settings": { "title": "NAD+", "url": "/pages/nad" } },
        { "type": "menu_link", "settings": { "title": "Journal", "url": "/blogs/news" } },
        { "type": "menu_link", "settings": { "title": "As Seen In", "url": "/" } },

        { "type": "menu_heading", "settings": { "heading": "Customer Care" } },
        { "type": "menu_link", "settings": { "title": "Contact Us", "url": "/pages/contact" } },
        { "type": "menu_link", "settings": { "title": "Profile", "url": "/account" } },
        { "type": "menu_link", "settings": { "title": "FAQ", "url": "/pages/faqs" } },
        { "type": "menu_link", "settings": { "title": "Return & Refund", "url": "/pages/legal" } },
        { "type": "menu_link", "settings": { "title": "Terms & Conditions", "url": "/pages/legal" } },
        { "type": "menu_link", "settings": { "title": "Privacy Policy", "url": "/pages/legal" } }
      ]
    }
  ]
}
{% endschema %}
