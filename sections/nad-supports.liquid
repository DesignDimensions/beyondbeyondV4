{{ 'nad-supports.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  What NAD+ does for skin, as a two-column run of points, each with its own
  line drawing. A tinted band rather than white, so it reads as the summary
  between the explanation above it and the argument below.

  The points are blocks so their order and number are the merchant's, and the
  grid fills across rather than down — the pair on each row belong beside each
  other, and a fifth point should start a new row rather than lengthen a
  column.
{%- endcomment -%}

<div
  class="nsu{% if section.settings.offset_header %} nsu--under-header{% endif %}"
  style="
    --nsu-pad-top: {{ section.settings.padding_top }}px;
    --nsu-pad-bottom: {{ section.settings.padding_bottom }}px;
    --nsu-bg: {{ section.settings.background }};
    --nsu-ink: {{ section.settings.ink }};
    --nsu-body-color: {{ section.settings.body_color }};
    --nsu-body-size: {{ section.settings.body_size }}px;
    --nsu-rule-color: {{ section.settings.rule_color }};
    --nsu-rule-gap: {{ section.settings.rule_gap }}px;
    --nsu-body-w: {{ section.settings.body_width }}px;
    --nsu-head-gap: {{ section.settings.head_gap }}px;
    --nsu-columns: {{ section.settings.columns_desktop }};
    --nsu-col-gap: {{ section.settings.column_gap }}px;
    --nsu-row-gap: {{ section.settings.row_gap }}px;
    --nsu-icon-size: {{ section.settings.icon_size }}px;
    --nsu-icon-gap: {{ section.settings.icon_gap }}px;
    --nsu-title-size: {{ section.settings.title_size }}px;
    --nsu-title-color: {{ section.settings.title_color }};
    --nsu-text-size: {{ section.settings.text_size }}px;
    --nsu-text-color: {{ section.settings.text_color }};
  "
  {{ section.shopify_attributes }}
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="section-title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- comment -%}
      A real `<hr>`: what separates the name of the section from the
      explanation under it is a thematic break, and that is the element that
      says so. Its own border is cleared in the stylesheet, since browsers
      draw one of their own.
    {%- endcomment -%}
    {%- if section.settings.show_rule -%}
      <hr class="nsu__rule">
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="nsu__intro section-text">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="nsu__grid">
        {%- for block in section.blocks -%}
          {%- liquid
            assign icon = block.settings.icon
            assign icon_src = block.settings.icon_url
            if icon != blank
              assign icon_src = icon | image_url: width: 240
            endif
          -%}

          <div class="nsu__item" {{ block.shopify_attributes }}>
            {%- comment -%}
              The drawing repeats what the title beside it already says, so it
              carries an empty alt rather than a description a reader would
              have to hear twice.
            {%- endcomment -%}
            {%- if icon_src != blank -%}
              <img
                class="nsu__icon"
                src="{{ icon_src }}"
                {%- if icon != blank %}
                  width="{{ icon.width }}"
                  height="{{ icon.height }}"
                {%- endif %}
                alt=""
                loading="lazy"
                decoding="async"
              >
            {%- else -%}
              <span class="nsu__icon nsu__icon--empty" aria-hidden="true"></span>
            {%- endif -%}

            <div class="nsu__copy">
              {%- if block.settings.title != blank -%}
                <h3 class="nsu__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="nsu__text">{{ block.settings.text }}</div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "NAD Supports",
  "tag": "section",
  "class": "section-nad-supports",
  "settings": [
    {
      "type": "header",
