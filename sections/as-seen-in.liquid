{{ 'as-seen-in.css' | asset_url | stylesheet_tag }}

{%- liquid
  comment
    The row prints the same logos twice. One copy is what you see; the second
    is what slides into its place, and the loop is nothing more than the track
    travelling exactly one copy's width and starting over — so there is never
    a gap to hide or a jump to smooth over. The script clones further copies
    when one is narrower than the window.
  endcomment
  assign separator = section.settings.separator_url
  if section.settings.separator != blank
    assign separator = section.settings.separator | image_url: width: 40
  endif
-%}

<div
  class="asi"
  id="asi-{{ section.id }}"
  data-asi
  data-speed="{{ section.settings.speed }}"
  style="
    --asi-pad-top: {{ section.settings.padding_top }}px;
    --asi-pad-bottom: {{ section.settings.padding_bottom }}px;
    --asi-heading-gap: {{ section.settings.heading_gap }}px;
    --asi-logo-h: {{ section.settings.logo_height }}px;
    --asi-logo-h-mobile: {{ section.settings.logo_height | times: 0.7 | round }}px;
    --asi-gap: {{ section.settings.logo_gap }}px;
    --asi-sep-h: {{ section.settings.separator_height }}px;
    --asi-tag-bg: {{ section.settings.tag_background }};
    --asi-tag-fg: {{ section.settings.tag_color }};
  "
  {{ section.shopify_attributes }}
>
  {%- if section.settings.show_glow -%}
    <span class="asi__glow" aria-hidden="true"></span>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <div class="page-width">
      <p class="section-heading asi__heading">{{ section.settings.heading }}</p>
    </div>
  {%- endif -%}

  <a
    class="asi__rows"
    href="{{ section.settings.view_all_url }}"
    data-asi-rows
    aria-label="{{ section.settings.heading | strip_html | default: 'As seen in' }} — {{ section.settings.view_all_label | strip_html }}"
  >
    <div
      class="asi__row"
      data-asi-row
      data-direction="{{ section.settings.direction }}"
    >
      <div class="asi__track" data-asi-track>
        {%- for copy in (1..2) -%}
          <div
            class="asi__seq"
            data-asi-seq
            {% unless forloop.first %}
              aria-hidden="true"
            {% endunless %}
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign logo = block
                assign image = logo.settings.image
                assign label = logo.settings.name
              -%}
              <div class="asi__cell">
                {%- capture logo_media -%}
                  {%- if image != blank -%}
                    <img
                      class="asi__logo-img"
                      src="{{ image | image_url: width: 480 }}"
                      srcset="{{ image | image_url: width: 240 }} 240w, {{ image | image_url: width: 480 }} 480w"
                      sizes="{{ section.settings.logo_height | times: 4 }}px"
                      width="{{ image.width }}"
                      height="{{ image.height }}"
                      alt="{{ label | escape }}"
                      loading="lazy"
                      decoding="async"
                    >
                  {%- elsif logo.settings.image_url != blank -%}
                    <img
                      class="asi__logo-img"
                      src="{{ logo.settings.image_url }}"
                      alt="{{ label | escape }}"
                      loading="lazy"
                      decoding="async"
                    >
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'asi__logo-img asi__logo-img--placeholder' }}
                  {%- endif -%}
                {%- endcapture -%}

                {%- comment -%}
                  A plain span, never a link: the whole row is one link to the
                  press page now, and an anchor nested inside it would be
                  invalid HTML.
                {%- endcomment -%}
                <span class="asi__logo" data-asi-logo {{ logo.shopify_attributes }}>
                  {{ logo_media }}
                </span>

                <span class="asi__sep" aria-hidden="true">
                  {%- if separator != blank -%}
                    <img class="asi__sep-img" src="{{ separator }}" alt="" loading="lazy" decoding="async">
                  {%- endif -%}
                </span>
              </div>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </a>

  {%- comment -%}
    The pointer tag — same construction as the testimonials rail's: a pill
    that rides beside the cursor, flips in over the row, and says what a
    click here does. Re-parented to <body> by the script.
  {%- endcomment -%}
  <span class="asi__cursor" data-asi-cursor aria-hidden="true">
    <span class="asi__cursor-flip" data-asi-cursor-flip>
      <span class="asi__cursor-text">{{ section.settings.view_all_label }}</span>
    </span>
  </span>
</div>

<script src="{{ 'as-seen-in.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "As Seen In",
  "tag": "section",
  "class": "section-as-seen-in",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "AS SEEN IN"
    },
    {
      "type": "range",
      "id": "heading_gap",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space below heading",
      "default": 40
    },
    {
      "type": "header",
      "content": "Logos"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "Logo height",
      "default": 54
    },
    {
      "type": "range",
      "id": "logo_gap",
      "min": 12,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Space between logos",
      "default": 56
    },
    {
      "type": "header",
      "content": "Separator"
    },
    {
      "type": "image_picker",
      "id": "separator",
      "label": "Separator image"
    },
    {
      "type": "text",
      "id": "separator_url",
      "label": "Separator image URL",
      "default": "https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Vector_605.png?v=1787043185",
      "info": "Used when no image is picked above."
    },
    {
      "type": "range",
      "id": "separator_height",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Separator height",
      "default": 46
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 160,
      "step": 5,
      "unit": "px",
      "label": "Speed",
      "info": "Pixels travelled per second.",
      "default": 45
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "1",
          "label": "Right"
        },
        {
          "value": "-1",
          "label": "Left"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "View all"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Pointer tag text",
      "default": "View All"
    },
    {
      "type": "text",
      "id": "view_all_url",
      "label": "Link",
      "info": "Where the row goes when clicked.",
      "default": "/pages/as-seen-in"
    },
    {
      "type": "color",
      "id": "tag_background",
      "label": "Pointer tag background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "tag_color",
      "label": "Pointer tag text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Glow"
    },
    {
      "type": "checkbox",
      "id": "show_glow",
      "label": "Show glow behind the rows",
      "default": true
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#8b7cf0"
    },
    {
      "type": "range",
      "id": "glow_opacity",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "label": "Glow strength",
      "default": 0.5
    },
    {
      "type": "range",
      "id": "glow_width",
      "min": 200,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Glow width",
      "default": 620
    },
    {
      "type": "range",
      "id": "glow_height",
      "min": 100,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Glow height",
      "default": 340
    },
    {
      "type": "range",
      "id": "glow_offset",
      "min": -200,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Glow vertical offset",
      "default": 0
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Logo image URL",
          "info": "Used when no image is picked above."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Publication name",
          "info": "Read out in place of the image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "As Seen In",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "name": "Vogue India",
            "image_url": "https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Frame_1321319004_1.png?v=1787043113"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "Cosmopolitan India",
            "image_url": "https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Asset_2_1_b4215a6b-8d52-496e-b612-29d92a5ba077.png?v=1787043112"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "Grazia",
            "image_url": "https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Asset_1_4_1.png?v=1787043110"
          }
        },
        {
          "type": "logo",
          "settings": {
            "name": "Elle",
            "image_url": "https://cdn.shopify.com/s/files/1/0715/1157/2666/files/Page-1_48656e87-4f44-4ab1-a73b-99ecb359dac3.png?v=1787043109"
          }
        }
      ]
    }
  ]
}
{% endschema %}
