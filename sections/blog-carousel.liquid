{{ 'blog-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  comment
    The blog picked in the settings supplies the rail; the call to action goes
    to that blog's own page unless the merchant has pointed it somewhere else,
    so 'view them all' lands on the list of every post rather than on nothing.
  endcomment
  assign bc_blog = blogs[section.settings.blog]
  assign cta_link = section.settings.cta_link
  if cta_link == blank
    assign cta_link = bc_blog.url
  endif

  assign posts = bc_blog.articles
  assign limit = section.settings.posts_limit
-%}

<div
  class="bc"
  id="bc-{{ section.id }}"
  data-bc
  style="
    --bc-pad-top: {{ section.settings.padding_top }}px;
    --bc-pad-bottom: {{ section.settings.padding_bottom }}px;
    --bc-split: {{ section.settings.split }}%;
    --bc-split-gap: {{ section.settings.split_gap }}px;
    --bc-cta-bg: {{ section.settings.cta_background }};
    --bc-cta-fg: {{ section.settings.cta_text_color }};
    --bc-cta-h: {{ section.settings.cta_height }}px;
    --bc-cta-max: {{ section.settings.cta_width }}px;
    --bc-gap: {{ section.settings.card_gap }}px;
    --bc-card-w: {{ section.settings.card_width }}cqw;
    --bc-card-w-mobile: {{ section.settings.card_width_mobile }}cqw;
    --bc-card-bg: {{ section.settings.card_background }};
    --bc-card-pad: {{ section.settings.card_padding }}px;
    --bc-media-ratio: {{ section.settings.media_ratio }};
    --bc-title-size: {{ section.settings.title_size }}px;
    --bc-title-color: {{ section.settings.title_color }};
    --bc-dot-color: {{ section.settings.dot_color }};
  "
  {{ section.shopify_attributes }}
>
  <div class="page-width bc__inner">
    <div class="bc__intro">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-title">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="bc__body section-text">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <a class="bc__cta" href="{{ cta_link | default: '#' }}">
          <span class="bc__cta-label">{{ section.settings.cta_label }}</span>
          {%- comment -%}
            The arrow the bestsellers' 'shop all' carries, so the two calls to
            action read as the same gesture. That file is a black glyph on
            transparent and this button is black, so the stylesheet takes its
            shape as a mask and fills it with the button's own text colour
            rather than placing it as a picture.
          {%- endcomment -%}
          <span class="bc__cta-arrow" aria-hidden="true"></span>
        </a>
      {%- endif -%}
    </div>

    <div class="bc__feed">
      <div
        class="bc__rail"
        data-bc-rail
        tabindex="0"
        role="group"
        aria-label="{{ bc_blog.title | default: section.settings.heading | escape }}"
      >
        {%- for article in posts limit: limit -%}
          <a class="bc__card" href="{{ article.url }}" draggable="false">
            <div class="bc__media">
              {%- if article.image != blank -%}
                <img
                  class="bc__img"
                  src="{{ article.image | image_url: width: 600 }}"
                  srcset="
                    {{ article.image | image_url: width: 300 }} 300w,
                    {{ article.image | image_url: width: 600 }} 600w,
                    {{ article.image | image_url: width: 900 }} 900w
                  "
                  sizes="(min-width: 750px) 30vw, 78vw"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  alt="{{ article.image.alt | default: article.title | escape }}"
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                >
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <div class="bc__card-body">
              <h3 class="bc__card-title">{{ article.title }}</h3>
            </div>
          </a>
        {%- else -%}
          {%- comment -%}
            Nothing picked yet, or a blog with no posts in it. The editor still
            needs to show the shape of the thing being set up, so it gets a
            railful of empty cards rather than a blank half-section.
          {%- endcomment -%}
          {%- for i in (1..4) -%}
            <div class="bc__card">
              <div class="bc__media">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="bc__card-body">
                <h3 class="bc__card-title">{{ 'sections.featured_blog.onboarding_title' | t }}</h3>
              </div>
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      {%- comment -%}
        Filled in by the script rather than here: how many dots a rail needs is
        how many railfuls of cards it holds, and that is a measurement of the
        window, which Liquid cannot take.
      {%- endcomment -%}
      {%- if section.settings.show_dots -%}
        <div
          class="bc__dots"
          data-bc-dots
          data-bc-dot-label="{{ 'general.slider.name' | t | escape }}"
        ></div>
      {%- endif -%}
    </div>
  </div>
</div>

<script src="{{ 'blog-carousel.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Blog Carousel",
  "tag": "section",
  "class": "section-blog-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Topics You Might Also Like!"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text",
      "default": "<p>Discover how intentional, clean clinical skincare can change your relationship with your skin forever.</p>"
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "View journal"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "info": "Leave empty to link to the blog picked below."
    },
    {
      "type": "color",
      "id": "cta_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "cta_text_color",
      "label": "Button text color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "cta_height",
      "min": 36,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Button height",
      "default": 48
    },
    {
      "type": "range",
      "id": "cta_width",
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "Button maximum width",
      "default": 470
    },
    {
      "type": "header",
      "content": "Posts"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_limit",
      "min": 2,
      "max": 16,
      "step": 1,
      "label": "Posts in the carousel",
      "default": 8
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Card width on desktop",
      "info": "A share of the carousel's half of the row, so a smaller card shows more of the next one.",
      "default": 55
    },
    {
      "type": "range",
      "id": "card_width_mobile",
      "min": 50,
      "max": 100,
      "step": 2,
      "unit": "%",
      "label": "Card width on mobile",
      "default": 78
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Space between cards",
      "default": 18
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape",
      "options": [
        { "value": "1", "label": "Square" },
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "3 / 4", "label": "Tall portrait" },
        { "value": "3 / 2", "label": "Landscape" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show sliding dots",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Title background",
      "default": "#EFEFEF"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Space around the title",
      "default": 16
    },
    {
      "type": "range",
      "id": "title_size",
      "min": 12,
      "max": 26,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 16
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title color",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "split",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "%",
      "label": "Width of the copy column",
      "default": 42
    },
    {
      "type": "range",
      "id": "split_gap",
      "min": 16,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Space between the columns",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Blog Carousel"
    }
  ]
}
{% endschema %}
